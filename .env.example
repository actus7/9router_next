# Copy this file to `.env` and fill in the real values.

# ─── Neon Postgres ───────────────────────────────────────────────────────────
# The whole app stores everything here; there is no local file fallback and no
# SQLite any more. Take the POOLED connection string from the Neon console (its
# host contains `-pooler`): the app opens interactive transactions, which the
# pooled endpoint supports and the HTTP one does not.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# The same endpoint WITHOUT `-pooler`, for DDL run by hand. The app itself never
# reads it.
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# ─── Neon Auth ───────────────────────────────────────────────────────────────
# Sign-in, sign-up, and the account every database row belongs to. From the Neon
# console under Auth → Configuration: the full auth endpoint, project host plus
# `/<database>/auth`. The app refuses to start without it — with accounts there
# is no such thing as an anonymous request that owns data.
NEON_AUTH_BASE_URL="https://ep-xxx.neonauth.region.aws.neon.tech/neondb/auth"

# Signs the session cookie, so a session verifies without a round trip.
# At least 32 characters. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Changing it signs everybody out.
NEON_AUTH_COOKIE_SECRET=

# ─── Deployment ──────────────────────────────────────────────────────────────
# Comma-separated hosts allowed to serve the dashboard. Empty means any host.
# Set it when the app is also reachable over a tunnel or Tailscale and the
# dashboard must not answer there. It replaces the old `tunnelDashboardAccess`
# setting, which could not survive per-account settings: the middleware has to
# decide before it knows which account is asking.
DASHBOARD_ALLOWED_HOSTS=

# ─── Google OAuth ────────────────────────────────────────────────────────────
# Required by every Google-based provider: `gemini`, `gemini-cli` and
# `antigravity` all read these. Create them in the Google Cloud Console under
# APIs & Services → Credentials, as an OAuth client of type "Desktop app".
#
# They were undocumented, and the registry falls back to "" when they are unset
# — which sent the operator to Google with an empty `client_id` and got back a
# bare `400 invalid_request`. The app now refuses to build that URL and names
# the missing variable, but it still cannot sign in without them.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Windsurf Firebase API Key (public key, used for OAuth flow)
WINDSURF_FIREBASE_API_KEY=

# ─── Credential encryption ───────────────────────────────────────────────────
# Encrypts provider credentials at rest (apiKey / accessToken / refreshToken /
# idToken inside providerConnections.data), using AES-256-GCM with a key derived
# via scrypt. Optional: with it unset the app boots and runs normally, storing
# those fields in the clear and warning on every boot.
#
# LOSING IT makes existing encrypted credentials unrecoverable — they are
# dropped on read with an error in the log, and each provider has to be
# reconnected. Back it up wherever you keep secrets, not next to the database.
CREDENTIAL_KEY=

# Set to "true" to make CREDENTIAL_KEY mandatory: the app then refuses to start
# without it instead of falling back to plaintext. Off by default so an upgrade
# cannot brick an install that never opted in. See docs/OPERATIONS.md.
CREDENTIAL_ENCRYPTION_REQUIRED=

# ─── Provider endpoints ──────────────────────────────────────────────────────
# Whether an account may point a provider (Ollama, an OpenAI/Anthropic
# compatible node, a custom embedding node) at a private or loopback address.
#
# On a self-hosted install that is the point: Ollama on 127.0.0.1:11434, an
# inference box on the LAN. On a deployment where anyone can sign up it is a
# server-side request forgery primitive — the account picks the URL, the gateway
# fetches it from inside your network, and the response comes back through the
# upstream error. That reaches cloud metadata on 169.254.169.254.
#
# Off by default, so a hosted deployment is safe without configuring anything.
ALLOW_PRIVATE_PROVIDER_ENDPOINTS=

# ─── Rate limits ─────────────────────────────────────────────────────────────
# Per-account request ceilings, per minute, counted per process. Both defaults
# sit far above what a person on the dashboard or a coding agent produces; they
# exist so a loop cannot burn the install's provider quota or its Neon compute.
# Set to 0 to disable a limit.
RATE_LIMIT_GATEWAY_PER_MINUTE=600
RATE_LIMIT_DASHBOARD_PER_MINUTE=1200

# Public URL of this gateway. A Cloud Deploy container runs on Render/Railway and
# calls back here to route its models, so it needs an address it can reach —
# localhost is not one. Without this (and with no `cloudUrl` in settings), a
# deploy is refused up front rather than shipping a container that cannot work.
# NEXT_PUBLIC_CLOUD_URL="https://your-instance.vercel.app"
