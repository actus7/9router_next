// use prisma-next

model Settings {
  id   Int  @id @default(1)
  data Json @default("{}")

  @@map("settings")
}

model ProviderConnection {
  id        String               @id @default(uuid())
  provider  String
  authType  String
  name      String?
  email     String?
  priority  Int?
  isActive  Boolean              @default(true)
  data      Json                 @default("{}")
  createdAt TimestamptzString    @default(now())
  updatedAt temporal.updatedAtString()

  @@index([provider])
  @@index([provider, isActive])
  @@index([provider, priority])
  @@map("provider_connections")
}

model ProviderNode {
  id        String               @id @default(uuid())
  type      String?
  name      String?
  data      Json                 @default("{}")
  createdAt TimestamptzString    @default(now())
  updatedAt temporal.updatedAtString()

  @@index([type])
  @@map("provider_nodes")
}

model ProxyPool {
  id         String               @id @default(uuid())
  isActive   Boolean              @default(true)
  testStatus String?
  data       Json                 @default("{}")
  createdAt  TimestamptzString    @default(now())
  updatedAt  temporal.updatedAtString()

  @@index([isActive])
  @@index([testStatus])
  @@map("proxy_pools")
}

model ApiKey {
  id        String            @id @default(uuid())
  key       String            @unique
  name      String?
  machineId String?
  isActive  Boolean           @default(true)
  createdAt TimestamptzString @default(now())

  @@index([key])
  @@map("api_keys")
}

model Combo {
  id        String               @id @default(uuid())
  name      String               @unique
  kind      String?
  models    Json                 @default("[]")
  createdAt TimestamptzString    @default(now())
  updatedAt temporal.updatedAtString()

  @@index([name])
  @@map("combos")
}

model Kv {
  scope String
  key   String
  value String

  @@id([scope, key])
  @@index([scope])
  @@map("kv")
}

model UsageHistory {
  id               Int               @id @default(autoincrement())
  timestamp        TimestamptzString @default(now())
  provider         String?
  model            String?
  connectionId     String?
  apiKey           String?
  endpoint         String?
  promptTokens     Int               @default(0)
  completionTokens Int               @default(0)
  cost             Float             @default(0)
  status           String?
  tokens           String?
  meta             Json?

  @@index([timestamp])
  @@index([provider])
  @@index([model])
  @@index([connectionId])
  @@map("usage_history")
}

model UsageDaily {
  dateKey String @id
  data    Json   @default("{}")

  @@map("usage_daily")
}

model RequestDetail {
  id           String               @id @default(uuid())
  timestamp    TimestamptzString    @default(now())
  provider     String?
  model        String?
  connectionId String?
  status       String?
  data         Json                 @default("{}")

  @@index([timestamp])
  @@index([provider])
  @@index([model])
  @@index([connectionId])
  @@map("request_details")
}

model User {
  id            String               @id @default(uuid())
  email         String               @unique
  name          String?
  passwordHash  String?
  image         String?
  emailVerified TimestamptzString?
  createdAt     TimestamptzString    @default(now())
  updatedAt     temporal.updatedAtString()

  sessions Session[]
  accounts Account[]

  @@map("users")
}

model Session {
  id        String               @id @default(uuid())
  userId    String
  token     String               @unique
  expiresAt TimestamptzString
  ipAddress String?
  userAgent String?
  createdAt TimestamptzString    @default(now())
  updatedAt temporal.updatedAtString()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String               @id @default(uuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  TimestamptzString?
  scope                 String?
  createdAt             TimestamptzString    @default(now())
  updatedAt             temporal.updatedAtString()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String               @id @default(uuid())
  identifier String
  value      String
  expiresAt  TimestamptzString
  createdAt  TimestamptzString    @default(now())
  updatedAt  temporal.updatedAtString()

  @@unique([identifier, value])
  @@map("verifications")
}
