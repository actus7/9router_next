{
  "name": "modelhub",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run contract:emit",
    "build": "next build",
    "start": "next start --port 20128",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:contract": "vitest run tests/contracts",
    "check": "npm run lint && npm run typecheck && npm run contract:check && npm run test:coverage && npm run build && git diff --check",
    "postinstall": "prisma skills sync || exit 0",
    "contract:emit": "prisma contract emit",
    "contract:check": "npm run contract:emit && git diff --exit-code -- src/prisma/contract.json src/prisma/contract.d.ts"
  },
