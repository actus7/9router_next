{
  "name": "modelhub",
  "type": "module",
  "version": "2.0.0",
  "engines": {
    "node": ">=22.18.0",
    "npm": ">=11.0.0"
  },
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run icons:emit && npm run extension:build && npm run contract:emit",
    "extension:build": "node scripts/build-web-session-extension.mjs",
    "build": "next build && npm run check:static-routes",
    "start": "next start --port 20128",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:contract": "vitest run tests/contracts",
    "check": "npm run lint && npm run contract:check && npm run build && npm run typecheck && npm run test:coverage && git diff --check",
    "check:static-routes": "node scripts/check-static-api-routes.mjs",
    "postinstall": "prisma skills sync || exit 0",
    "contract:emit": "prisma contract emit",
    "contract:check": "npm run contract:emit && git diff --exit-code -- src/prisma/contract.json src/prisma/contract.d.ts",
    "icons:emit": "node scripts/gen-provider-icons.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@jitl/quickjs-singlefile-cjs-release-sync": "^0.32.0",
    "@monaco-editor/react": "^4.7.0",
    "@neondatabase/auth": "^0.7.0-beta",
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/functions": "^3.10.3",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "confbox": "^0.3.1",
    "cordis": "^4.0.0-rc.12",
    "jose": "^6.2.13",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.61.0",
    "modelparams": "0.0.72",
    "monaco-editor": "^0.57.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "node-machine-id": "^1.1.12",
    "quickjs-emscripten-core": "^0.32.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "undici": "^8.12.3",
    "uuid": "^14.0.3",
    "ws": "^8.22.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@prisma/cli-engine": "^0.9.0",
    "@prisma/orm-postgres": "8.0.0-rc.20",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/jest-axe": "^3.5.9",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.5",
    "dotenv": "^18.0.9",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jest-axe": "^11.0.0",
    "prisma": "8.0.0-rc.27",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@prisma/dev": "0.25.2",
    "deepmerge-ts": "^8.0.2",
    "dompurify": "3.4.17",
    "mysql2": "^3.24.5"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3"
  }
}
